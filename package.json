{
  "name": "merbut",
  "private": true,
  "version": "3.2.0",
  "description": "Hz. Ali ve Samuray Jack, Aku'yu durdurmak için on diyarı aşar. / Hazrat Ali and Samurai Jack cross ten realms to stop Aku.",
  "author": {
    "name": "MeMoDe"
  },
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:demo": "node ./node_modules/vite/bin/vite.js --mode demo",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b --pretty false",
    "check:version": "node scripts/check-version-sync.mjs",
    "prebuild": "node scripts/check-version-sync.mjs && node ./node_modules/typescript/bin/tsc -b --pretty false",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "prebuild:demo": "node scripts/check-version-sync.mjs && node ./node_modules/typescript/bin/tsc -b --pretty false",
    "build:demo": "node ./node_modules/vite/bin/vite.js build --mode demo",
    "lint": "node ./node_modules/oxlint/bin/oxlint .",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "prepare:aku": "node scripts/prepare-aku-assets.mjs",
    "optimize:web-assets": "node scripts/optimize-web-assets.mjs",
    "art": "node scripts/art/generate-art.mjs",
    "package:itch": "npm run build && node scripts/package-itch.mjs",
    "package:desktop": "npm run build && node ./node_modules/electron-builder/cli.js --config desktop/electron-builder.json --win",
    "package:desktop:linux": "npm run build && node ./node_modules/electron-builder/cli.js --config desktop/electron-builder.json --linux",
    "desktop": "node ./node_modules/electron/cli.js ."
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "leva": "^0.10.1",
    "postprocessing": "^6.39.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
